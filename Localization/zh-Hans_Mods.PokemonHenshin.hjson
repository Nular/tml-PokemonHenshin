	A01AbilityCapsuleBelt: {
		DisplayName: 万能胶囊带
		Tooltip:
			'''
			如果用于有着２种特性的宝可梦，就能令其现有特性变为另一种的胶囊——改装成腰带后，略微缩短招式间隔。
			仅变身时：招式冷却 ×0.95
			'''
	}

	A02MuscleBand: {
		DisplayName: 专注头带
		Tooltip:
			'''
			力如泉涌的头带。携带后，物理招式的威力就会少量提高。
			仅变身时：本模伤害 +6%
			'''
	}

	A03SoulDewPendant: {
		DisplayName: 气息挂坠
		Tooltip:
			'''
			让拉帝欧斯或拉帝亚斯携带后，超能力和龙属性的招式威力就会提高的神奇珠子。
			仅变身时：情境加成幅度 +20%
			'''
	}

	A04FloatStoneAnklet: {
		DisplayName: 轻身脚环
		Tooltip:
			'''
			非常轻的石头。携带后，宝可梦的体重会变轻。
			仅变身时：飞行能量 +1s；移速 +5%
			'''
	}

	A05FocusSashBadge: {
		DisplayName: 守护徽章
		Tooltip:
			'''
			携带后，在ＨＰ全满时，即便受到可能会导致濒死的招式，也能仅以１ＨＰ撑过去１次。
			仅变身时：受伤 ×0.94
			'''
	}

	A06LifeOrbCore: {
		DisplayName: 灾限核心
		Tooltip:
			'''
			携带后，虽然每次攻击时ＨＰ少量减少，但招式的威力会提高。
			仅变身时：HenshinDamageFactor +0.05
			'''
	}

	A07CharcoalBag: {
		DisplayName: 木炭袋
		Tooltip:
			'''
			焚烧用的燃料。携带后，火属性的招式威力就会提高。
			火共鸣·仅变身：对着火目标额外 +8%
			'''
	}

	A08MysticWaterPouch: {
		DisplayName: 水囊
		Tooltip:
			'''
			水滴形状的宝石。携带后，水属性的招式威力就会提高。
			水共鸣·仅变身：水中移速再 +10%
			'''
	}

	A09MagnetChip: {
		DisplayName: 电池片
		Tooltip:
			'''
			强力的磁铁。携带后，电属性的招式威力就会提高。
			电共鸣·仅变身：冲刺冷却 ×0.85
			'''
	}

	A10SharpBeakMembrane: {
		DisplayName: 薄翼膜
		Tooltip:
			'''
			又长又尖的鸟嘴。携带后，飞行属性的招式威力就会提高。
			飞共鸣·仅变身：坠落减免提高到 75%
			'''
	}

	A11SpellTagCloth: {
		DisplayName: 咒符布
		Tooltip:
			'''
			古怪可怕的咒符。携带后，幽灵属性的招式威力就会提高。
			幽灵共鸣·仅变身：穿障 +0.5s（封顶 2.0s）
			'''
	}

	A12DragonFangCharm: {
		DisplayName: 龙牙饰
		Tooltip:
			'''
			坚硬锐利的牙齿。携带后，龙属性的招式威力就会提高。
			龙共鸣·仅变身：对 Boss 再 +6%
			'''
	}
}

