	A01AbilityCapsuleBelt: {
		DisplayName: Ability Capsule Belt
		Tooltip:
			'''
			A capsule that switches Abilities - remade as a belt.
			Henshin only: move cooldown x0.95
			'''
	}

	A02MuscleBand: {
		DisplayName: Focus Headband
		Tooltip:
			'''
			An exhilarating band that slightly boosts physical moves.
			Henshin only: +6% henshin damage
			'''
	}

	A03SoulDewPendant: {
		DisplayName: Aura Pendant
		Tooltip:
			'''
			A wondrous orb that powers Psychic and Dragon moves for Latios/Latias.
			Henshin only: affinity amplitude +20%
			'''
	}

	A04FloatStoneAnklet: {
		DisplayName: Light Anklet
		Tooltip:
			'''
			An extremely light stone that reduces weight.
			Henshin only: flight energy +1s; move speed +5%
			'''
	}

	A05FocusSashBadge: {
		DisplayName: Guard Badge
		Tooltip:
			'''
			Survives a would-be KO at full HP once.
			Henshin only: damage taken x0.94
			'''
	}

	A06LifeOrbCore: {
		DisplayName: Calamity Core
		Tooltip:
			'''
			Powers moves at a cost of HP.
			Henshin only: HenshinDamageFactor +0.05
			'''
	}

	A07CharcoalBag: {
		DisplayName: Charcoal Pouch
		Tooltip:
			'''
			Fuel that powers Fire moves.
			Fire resonance: +8% vs burning targets
			'''
	}

	A08MysticWaterPouch: {
		DisplayName: Water Bladder
		Tooltip:
			'''
			A teardrop gem that powers Water moves.
			Water resonance: +10% swim speed
			'''
	}

	A09MagnetChip: {
		DisplayName: Battery Chip
		Tooltip:
			'''
			A powerful magnet that powers Electric moves.
			Electric resonance: dash cooldown x0.85
			'''
	}

	A10SharpBeakMembrane: {
		DisplayName: Wing Membrane
		Tooltip:
			'''
			A long, sharp beak that powers Flying moves.
			Flying resonance: fall reduction to 75%
			'''
	}

	A11SpellTagCloth: {
		DisplayName: Spell Cloth
		Tooltip:
			'''
			An eerie tag that powers Ghost moves.
			Ghost resonance: phasing +0.5s (cap 2.0s)
			'''
	}

	A12DragonFangCharm: {
		DisplayName: Dragon Fang Charm
		Tooltip:
			'''
			A hard, sharp fang that powers Dragon moves.
			Dragon resonance: +6% vs bosses
			'''
	}

	A13WideLens: {
		DisplayName: Wide Lens
		Tooltip: Henshin only: ranged projectiles gain angular homing
	}

	A14ChoiceBand: {
		DisplayName: Choice Band
		Tooltip: Henshin only: Skill1 only (no Skill2/Ult); +50% henshin damage
	}

	A15ScopeLens: {
		DisplayName: Scope Lens
		Tooltip: Henshin only: 10% crit-tier upgrade (miss→crit; crit→×4 hypercrit)
	}

	A16LifeOrb: {
		DisplayName: Life Orb
		Tooltip: Henshin only: -1 HP on move hit; +20% damage
	}

	A17ShellBell: {
		DisplayName: Shell Bell
		Tooltip: Henshin only: heal 2 HP on hit (short CD like Calamity lifesteal)
	}

	A18RockyHelmet: {
		DisplayName: Rocky Helmet
		Tooltip: Henshin only: on hurt, damage nearby foes for 1.0× henshin base damage
	}

	A19ChargeBelt: {
		DisplayName: Charge Belt
		Tooltip: Henshin only: +30% ultimate energy on hit
	}

	A20EchoPendant: {
		DisplayName: Echo Pendant
		Tooltip: Henshin only: keep 20% energy after ultimate
	}

	A21BurstArmband: {
		DisplayName: Burst Armband
		Tooltip: Henshin only: +25% ultimate damage; -20% energy gain
	}
}

